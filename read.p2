// ═══════════════════════════════════════════════════════════
//  models/Usuario.js — OPERAÇÕES NO BANCO
// ═══════════════════════════════════════════════════════════

/*
const { obterColecao } = require('../database');
const { ObjectId }     = require('mongodb'); // necessário para buscar por _id

// Atalho para a coleção "usuarios"
function colecao() {
    return obterColecao('usuarios');
}

// ── CREATE — cadastrar novo usuário ───────────────────────
async function criarUsuario({ nome, login, senha }) {
    // Verifica se o login já existe
    const existente = await colecao().findOne({ login: login.toLowerCase().trim() });
    if (existente) throw new Error('Login já cadastrado');

    return colecao().insertOne({
        nome:     nome.trim(),
        login:    login.toLowerCase().trim(),
        senha,                    // ⚠️ em produção usar bcrypt
        criadoEm: new Date()
    });
}

// ── READ — buscar um usuário pelo login ───────────────────
async function buscarPorLogin(login) {
    return colecao().findOne({ login: login.toLowerCase().trim() });
}

// ── READ — listar todos os usuários ──────────────────────
async function listarUsuarios() {
    return colecao().find().toArray();
}

// ── UPDATE — atualizar senha ──────────────────────────────
async function atualizarSenha(id, novaSenha) {
    return colecao().updateOne(
        { _id: new ObjectId(id) },      // filtro: encontra pelo _id
        { $set: { senha: novaSenha } }  // $set: atualiza só o campo senha
    );
}

// ── DELETE — remover usuário ──────────────────────────────
async function deletarUsuario(id) {
    return colecao().deleteOne({ _id: new ObjectId(id) });
}

module.exports = { criarUsuario, buscarPorLogin, listarUsuarios, atualizarSenha, deletarUsuario };
*/




// ═══════════════════════════════════════════════════════════
//  routes/rotas-usuario.js — ROTAS HTTP
// ═══════════════════════════════════════════════════════════

/*
const express = require('express');
const router  = express.Router();
const { criarUsuario, buscarPorLogin } = require('../models/Usuario');

// ── Middleware: bloqueia rota se não estiver logado ───────
function exigirLogin(req, res, next) {
    if (!req.session.usuario) return res.redirect('/usuario/login');
    next(); // continua para a rota
}

// ── GET /usuario/cadastro — exibe o formulário ────────────
router.get('/cadastro', (req, res) => {
    res.render('cadastro', { erro: null, sucesso: null });
});

// ── POST /usuario/cadastro — salva no banco ───────────────
router.post('/cadastro', async (req, res) => {
    const { nome, login, senha } = req.body; // pega os campos do formulário
    try {
        await criarUsuario({ nome, login, senha });
        // Após cadastro, vai para login com mensagem de sucesso
        res.render('login', { erro: null, sucesso: 'Usuário cadastrado! Faça login.' });
    } catch (err) {
        // Se der erro (ex: login duplicado), volta para cadastro com a mensagem
        res.render('cadastro', { erro: err.message, sucesso: null });
    }
});

// ── GET /usuario/login — exibe o formulário ───────────────
router.get('/login', (req, res) => {
    res.render('login', { erro: null, sucesso: null });
});

// ── POST /usuario/login — verifica senha e cria sessão ───
router.post('/login', async (req, res) => {
    const { login, senha } = req.body;
    try {
        const usuario = await buscarPorLogin(login);

        // Se não encontrou ou senha errada
        if (!usuario || usuario.senha !== senha) {
            return res.render('login', { erro: 'Login ou senha incorretos', sucesso: null });
        }

        // Salva o usuário na sessão
        req.session.usuario = { id: usuario._id, nome: usuario.nome, login: usuario.login };

        res.redirect('/usuario/painel'); // redireciona após login
    } catch (err) {
        res.render('login', { erro: 'Erro interno. Tente novamente.', sucesso: null });
    }
});

// ── GET /usuario/painel — página após login ───────────────
router.get('/painel', exigirLogin, (req, res) => {
    res.render('painel', { usuario: req.session.usuario });
});

// ── GET /usuario/logout — encerra a sessão ────────────────
router.get('/logout', (req, res) => {
    req.session.destroy(); // apaga a sessão
    res.redirect('/usuario/login');
});

module.exports = router;
*/




