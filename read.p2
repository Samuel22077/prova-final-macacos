// ═══════════════════════════════════════════════════════════
//  REFERÊNCIA COMPLETA — PROVA FULL STACK
//  Node.js + Express + MongoDB (driver nativo) + EJS + Session
// ═══════════════════════════════════════════════════════════




// ─────────────────────────────────────────────────────────
//  ESTRUTURA DE PASTAS
// ─────────────────────────────────────────────────────────
//
//  projeto/
//  ├── server.js               → sobe o servidor
//  ├── database.js             → conecta ao MongoDB
//  ├── .env                    → variáveis de ambiente
//  ├── package.json            → dependências
//  ├── models/
//  │   └── Usuario.js          → operações no banco
//  ├── routes/
//  │   └── rotas-usuario.js    → rotas HTTP
//  ├── views/
//  │   ├── login.ejs           → página de login
//  │   ├── cadastro.ejs        → página de cadastro
//  │   └── painel.ejs          → página após login
//  └── public/
//      └── css/
//          └── estilos.css     → estilos




// ─────────────────────────────────────────────────────────
//  COMANDOS ESSENCIAIS (rodar no CMD)
// ─────────────────────────────────────────────────────────
//
//  npm install                 → instala dependências
//  net start MongoDB           → liga o banco local
//  npm start                   → sobe o servidor
//  http://localhost:3000       → abre no navegador




// ─────────────────────────────────────────────────────────
//  .env
// ─────────────────────────────────────────────────────────
//
//  MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxx.mongodb.net/nomedobanco?appName=Cluster0
//  SEGREDO_SESSAO=segredo123
//  PORTA=3000
//
//  → Para banco local:
//  MONGO_URI=mongodb://127.0.0.1:27017/nomedobanco




