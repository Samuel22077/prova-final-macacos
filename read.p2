// ═══════════════════════════════════════════════════════════
//  EJS — SINTAXE BÁSICA
// ═══════════════════════════════════════════════════════════

//  <%= variavel %>          → imprime o valor na tela
//  <% if (x) { %>           → condicional (não imprime)
//  <% } %>                  → fecha o bloco
//  <% array.forEach(...) %> → loop
//  <%- html %>              → imprime HTML sem escapar

/*
Exemplo de loop numa tabela:
<% carros.forEach(function(carro) { %>
    <tr>
        <td><%= carro.marca %></td>
        <td><%= carro.modelo %></td>
    </tr>
<% }); %>
*/




// ═══════════════════════════════════════════════════════════
//  MONGODB — OS 5 MÉTODOS ESSENCIAIS
// ═══════════════════════════════════════════════════════════

//  INSERT (Create)
//  colecao().insertOne({ campo: valor, ... })

//  FIND ONE (Read)
//  colecao().findOne({ campo: valor })

//  FIND ALL (Read)
//  colecao().find().toArray()

//  UPDATE (Update)
//  colecao().updateOne({ _id: new ObjectId(id) }, { $set: { campo: valor } })

//  DELETE (Delete)
//  colecao().deleteOne({ _id: new ObjectId(id) })




// ═══════════════════════════════════════════════════════════
//  FLUXO DO LOGIN — ENTENDER DE COR
// ═══════════════════════════════════════════════════════════

//  1. Usuário preenche login e senha no formulário
//  2. POST /usuario/login recebe req.body.login e req.body.senha
//  3. buscarPorLogin() faz findOne no banco
//  4. Se não encontrou ou senha errada → renderiza login com erro
//  5. Se ok → salva em req.session.usuario e redireciona
//  6. Em rotas protegidas → verifica se req.session.usuario existe
//  7. Logout → req.session.destroy() e redireciona para login




// ═══════════════════════════════════════════════════════════
//  O QUE MUDAR SE O PROFESSOR DER UM HTML DIFERENTE
// ═══════════════════════════════════════════════════════════

//  1. Coloca o arquivo na pasta views/
//  2. Renomeia para .ejs
//  3. Verifica se os name dos inputs são: nome, login, senha
//     → Se forem diferentes, muda na rota: const { nome, login, senha } = req.body
//  4. Adiciona as variáveis EJS onde precisar:
//     <% if (erro) { %> ... <% } %>
//  5. Verifica se o action do form bate com a rota:
//     action="/usuario/login" method="POST"
