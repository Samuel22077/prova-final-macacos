<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Cadastro</title>
    <link rel="stylesheet" href="/estilos.css">
</head>
<body>
    <div class="container">
        <h1>Criar Conta</h1>

        <% if (erro) { %>
            <div class="msg-erro"><%= erro %></div>
        <% } %>

        <% if (sucesso) { %>
            <div class="msg-sucesso"><%= sucesso %></div>
        <% } %>

        <form action="/cadastro" method="POST">
            <label>Nome completo</label>
            <input type="text" name="nome" required placeholder="João Silva">

            <label>Login</label>
            <input type="text" name="login" required placeholder="joaosilva">

            <label>Senha</label>
            <input type="password" name="senha" required placeholder="••••••••">

            <button type="submit" class="btn">Cadastrar</button>
        </form>

        <p class="link-rodape">Já tem conta? <a href="/login">Entrar</a></p>
    </div>
</body>
</html>
